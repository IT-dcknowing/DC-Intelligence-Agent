# =============================================================================
# DC INTELLIGENCE — FICHIER EXEMPLE CONFIGURATION (.env.example)
# Orchestrateur Central de l'Écosystème DC-KNOWING
# =============================================================================

# 1. LLM PROVIDERS
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY"
DEEPSEEK_API_KEY="sk-YOUR_DEEPSEEK_KEY"
ANTHROPIC_API_KEY="sk-ant-YOUR_ANTHROPIC_KEY"
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_KEY"
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_KEY"

# 2. VISION & MULTIMODAL (VLM)
VLM_PROVIDER="openrouter"
VLM_MODEL="inclusionai/ling-3.0-flash-vl:free"

# 3. VOICE & AUDIO (STT / TTS)
GROQ_API_KEY="gsk_YOUR_GROQ_KEY"
WHISPER_MODEL="whisper-large-v3-turbo"
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_KEY"

# 4. WHATSAPP META BUSINESS API
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_WABA_ID="YOUR_WABA_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_META_PERMANENT_ACCESS_TOKEN"
WHATSAPP_VERIFY_TOKEN="dc_intelligence_webhook_secure_token"
# URL à renseigner dans Meta App Dashboard > WhatsApp > Configuration (champ Callback URL).
# L'URL nue est aussi tolérée (même traitement), mais la forme canonique ci-dessous est recommandée.
WHATSAPP_WEBHOOK_URL="https://whatsappwebhook-rwksu3phma-uc.a.run.app/webhook"

# 5. DC-KNOWING MCP ENDPOINTS
LEGAL_FLOW_MCP_URL="https://legal-flow.dc-knowing.com/mcp"
COMPTA_FLOW_MCP_URL="https://compta-flow.dc-knowing.com/mcp"
RECO_MCP_URL="https://reco.dc-knowing.com/mcp"

# 6. SECURITY & SERVER
APP_ENV="development"
APP_URL="http://localhost:3000"
JWT_SECRET="dc_knowing_secret_key"
WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET_FOR_HMAC"
MCP_TOKEN="YOUR_SHARED_MCP_TOKEN_IF_ANY"
ALLOWED_ORIGINS="http://localhost:3000,https://dcintelligenceio.web.app"
KNOWLEDGE_BUCKET="dcintelligenceio-knowledge"

# 7. GOOGLE OAUTH 2.0 (connecteurs Sheets/Docs) — BACKEND UNIQUEMENT
# Prérequis Google Cloud Console (projet dcintelligenceio) :
#  - APIs & Services > Library : activer Google Sheets API, Google Docs API, Google Drive API.
#  - OAuth consent screen : External, app "DC Intelligence Agent Studio", scopes
#    spreadsheets + documents + drive.file + userinfo.email, Test users : ton email.
#  - Credentials > OAuth client ID (Web application) :
#      Authorized JavaScript origins :
#        https://dcintelligenceio.web.app
#        http://localhost:3000
#      Authorized redirect URIs :
#        https://us-central1-dcintelligenceio.cloudfunctions.net/whatsappWebhook/oauth/callback
#        http://127.0.0.1:5001/dcintelligenceio/us-central1/whatsappWebhook/oauth/callback
# Le CLIENT_SECRET ne sort jamais du backend (Secret Manager ou functions/.env, gitignoré).
# Circuit : front -> GET /api/google/auth-url -> popup Google -> GET /oauth/callback
# (échange code<->tokens, refresh_token en coffre Firestore users/admin/connections).
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
# Optionnel (défaut = URL Cloud Functions ci-dessus) :
# GOOGLE_OAUTH_REDIRECT_URI="https://us-central1-dcintelligenceio.cloudfunctions.net/whatsappWebhook/oauth/callback"
# Single-admin : aucun multi-user, les tokens sont rangés sous cet UID.
# DC_ADMIN_UID="admin"

# 8. FRONT VITE (IMPORTANT)
# Vite n'expose au navigateur QUE les variables préfixées VITE_.
# Ton .env racine actuel (OPENROUTER_API_KEY, etc.) est lu par le BACKEND (functions/)
# via dotenv, jamais par le front. Ne mets JAMAIS de clé secrète en VITE_ en prod.
# Le front appelle /api/chat (proxy backend) en priorité, et n'utilise la clé
# locale que si tu la saisis dans Paramètres > Clés API.
# Exemple dev uniquement :
# VITE_API_BASE_URL="http://localhost:3000/api"
# VITE_OPENROUTER_API_KEY="sk-or-v1-DEV_ONLY"
# VITE_GOOGLE_ACCOUNT_EMAIL=""  # optionnel, prérempli après OAuth réel
# NOTE : plus de VITE_GOOGLE_CLIENT_ID — le flux OAuth passe par le backend
# (GET /api/google/auth-url), l'ancien flux implicite côté front est supprimé.

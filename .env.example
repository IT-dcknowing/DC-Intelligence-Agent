# =============================================================================
# DC INTELLIGENCE — FICHIER EXEMPLE CONFIGURATION (.env.example)
# Orchestrateur Central de l'Écosystème DC-KNOWING
# =============================================================================

# 1. LLM PROVIDERS
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY"
DEEPSEEK_API_KEY="sk-YOUR_DEEPSEEK_KEY"
ANTHROPIC_API_KEY="sk-ant-YOUR_ANTHROPIC_KEY"
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_KEY"
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_KEY"

# 2. VISION & MULTIMODAL (VLM)
VLM_PROVIDER="openrouter"
VLM_MODEL="google/gemini-2.0-flash-exp:free"

# 3. VOICE & AUDIO (STT / TTS)
GROQ_API_KEY="gsk_YOUR_GROQ_KEY"
WHISPER_MODEL="whisper-large-v3-turbo"
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_KEY"

# 4. WHATSAPP META BUSINESS API
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_WABA_ID="YOUR_WABA_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_META_PERMANENT_ACCESS_TOKEN"
WHATSAPP_VERIFY_TOKEN="dc_intelligence_webhook_secure_token"
WHATSAPP_WEBHOOK_URL="https://your-domain.com/v1/whatsapp/webhook"

# 5. DC-KNOWING MCP ENDPOINTS
LEGAL_FLOW_MCP_URL="https://legal-flow.dc-knowing.com/mcp"
COMPTA_FLOW_MCP_URL="https://compta-flow.dc-knowing.com/mcp"
RECO_MCP_URL="https://reco.dc-knowing.com/mcp"

# 6. SECURITY & SERVER
APP_ENV="development"
APP_URL="http://localhost:3000"
JWT_SECRET="dc_knowing_secret_key"
